PUPPY_API_KEY=*YOUR_API_KEY_HERE*
PUPPY_STREAM_URL=https://puppyclicker-api.boundfire.com/api/v2/stream
PUPPY_AUTH_HEADER=Authorization
PUPPY_AUTH_PREFIX=Bearer 
XTOYS_START_URL=*YOUR_WEBHOOK_URL_HERE*
XTOYS_STOP_URL=*YOUR_WEBHOOK_URL_HERE*
XTOYS_METHOD=POST
XTOYS_START_JSON={"action":"puppy_start"}
XTOYS_STOP_JSON={"action":"puppy_stop"}
